# GitHub Pages builds this site with the github-pages gem, which pins Jekyll and
# every allowed plugin to the exact versions Pages runs server-side. Building
# locally against this gem is the only way to see what Pages will actually serve.
source "https://rubygems.org"

gem "github-pages", group: :jekyll_plugins

# Windows and JRuby do not include zoneinfo files; bring the tzinfo data.
gem "tzinfo-data", platforms: [:mingw, :mswin, :x64_mingw, :jruby]

# Faster file watching on macOS during `jekyll serve`.
gem "wdm", "~> 0.1.1", platforms: [:mingw, :mswin, :x64_mingw]
